# =============================================================================
# SwiftSign environment variables
# Copy to .env.local for development, set as project env vars on Vercel for prod.
# =============================================================================

# --- Database (Neon PostgreSQL) -----------------------------------------------
DATABASE_URL="postgresql://user:password@host/swiftsign?sslmode=require"

# --- Cloudflare R2 (S3-compatible blob storage) -------------------------------
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="swiftsign"
# Optional override; defaults to https://${R2_ACCOUNT_ID}.r2.cloudflarestorage.com
R2_ENDPOINT=""

# --- Resend (transactional email) ---------------------------------------------
RESEND_API_KEY="re_..."
EMAIL_FROM="SwiftSign <noreply@swiftsign.ca>"

# --- Stripe (billing) ---------------------------------------------------------
# Create products in the Stripe Dashboard, copy the recurring price IDs.
# Test keys (sk_test_…) for dev, live keys (sk_live_…) for prod.
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRICE_PRO_MONTHLY="price_..."
STRIPE_PRICE_TEAM_MONTHLY="price_..."

# --- Upstash Redis (rate limiting) --------------------------------------------
UPSTASH_REDIS_REST_URL="https://...upstash.io"
UPSTASH_REDIS_REST_TOKEN=""

# --- Sentry (observability) ---------------------------------------------------
# Optional. If set, server + edge errors are sent to Sentry.
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""

# --- Cron secret --------------------------------------------------------------
# Vercel cron sets `Authorization: Bearer <CRON_SECRET>` on scheduled requests.
# Use a long random string (>= 16 chars).
CRON_SECRET=""

# --- App ----------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Optional: webhook delivery timeout (default 5000) ------------------------
# WEBHOOK_TIMEOUT_MS=5000

# --- Optional: signing certificate (legacy, unused in current code path) ------
P12_CERT_PATH="certs/swiftsign.p12"
P12_CERT_PASSWORD="swiftsign"
